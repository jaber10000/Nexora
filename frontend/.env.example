# Copy to .env and fill in. NEVER commit .env.
# Neon connection string (paste your real password, keep sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-odd-grass-b3jgom2n-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
FRONTEND_ORIGIN=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=change-this-admin-password

# --- Email notifications (optional). With SMTP_HOST empty, emails are only recorded in the admin Email log.
# Gmail example: smtp.gmail.com / 587 / your address / an App Password.   Brevo, Mailgun, SES etc. work too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=NEXORA <no-reply@yourdomain.com>
NOTIFY_EMAIL=
REFUND_WINDOW_DAYS=7
